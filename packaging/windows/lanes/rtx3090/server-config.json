{
  "artifact_type": "ninfer_windows_server_config",
  "schema_version": 3,
  "release_id": "qwen38-3090-native-v0.6.0-beta.1",
  "deployment_profile": "qwen38-3090-native-v0.6.0-beta.1",
  "listen": {
    "host": "127.0.0.1",
    "port": 18082,
    "allowed_host_classes": [
      "loopback",
      "tailscale-ipv4"
    ]
  },
  "authentication": {
    "mode": "required-api-key-file"
  },
  "model_id": "q38-ninfer",
  "engine": {
    "device": 0,
    "max_context": 131072,
    "kv_capacity": 131072,
    "prefill_chunk": 1024,
    "kv_dtype": "int8",
    "max_concurrency": 1,
    "max_pending_requests": 16,
    "pending_timeout_ms": 30000,
    "cuda_graph": true,
    "prefix_reuse": true,
    "vision": false
  },
  "context_cache": {
    "device_state_slots": 4,
    "host_state_slots": 24,
    "host_kv_mib": 8192,
    "max_private_continuations": 8
  },
  "speculative": {
    "backend": "mtp",
    "draft_tokens": 3
  },
  "reasoning": {
    "thinking": true,
    "preserve_thinking": true
  },
  "session_checkpoint": {
    "enabled": true,
    "quota_mib": 24576,
    "staging_mib": 256
  },
  "response_store": {
    "max_records": 1024,
    "max_mib": 256
  },
  "telemetry": {
    "request_log_jsonl": true,
    "stats_interval_ms": 5000
  }
}
