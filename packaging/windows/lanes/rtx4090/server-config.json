  "listen": {
    "host": "127.0.0.1",
    "port": 18082,
    "allowed_host_classes": [
      "loopback",
      "tailscale-ipv4"
    ]
  },
  "authentication": {
    "mode": "required-api-key-file"
  },
  "model_id": "qwen3.8-27b",
  "engine": {
    "device": 0,
    "max_context": 131072,
    "kv_capacity": 131072,
    "prefill_chunk": 2048,
    "kv_dtype": "int8",
    "max_concurrency": 1,
    "max_pending_requests": 16,
    "pending_timeout_ms": 30000,
