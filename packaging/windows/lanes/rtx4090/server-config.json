    "quota_mib": 24576,
    "staging_mib": 256
  },
  "response_store": {
    "max_records": 1024,
    "max_mib": 256
  },
  "telemetry": {
    "request_log_jsonl": true,
    "stats_interval_ms": 5000
  },
  "runtime_host": {
    "minimum_runtime_memory_mib": 32768,
    "reason": "the host-KV pool is pinned memory and must hold the session being restored: a session at the 131,072-token ceiling needs 5.02 GiB of INT8 KV. Restore may reclaim another resident session only when its latest checkpoint is reproducible. Retain the qualified 11264 MiB allocation and 32768 MiB host floor rather than declare an unmeasured smaller-host profile. On the measured 32.4 GiB host, 11264 MiB pins with 11.6 GiB still free; 12288 MiB fails cudaMallocHost. Automatic checkpoints remain best effort under live traffic."
  }
}
