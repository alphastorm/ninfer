float2bfloat16_rn(value(random));\n    for(auto& x:residual)x=__float2bfloat16_rn(value(random));\n    Buffer<std::uint8_t> dc(codes.size()),dh(high.size());\n    Buffer<__half> ds(scales.size());\n    Buffer<__nv_bfloat16> dx(input.size()),before(residual.size()),after(residual.size());\n    check(cudaMemcpy(dc.data,codes.data(),codes.size(),cudaMemcpyHostToDevice));\n    check(cudaMemcpy(dh.data,high.data(),high.size(),cudaMemcpyHostToDevice));\n    check(cudaMemcpy(ds.data,scales.data(),scales.size()*2,cudaMemcpyHostToDevice));\n    check(cudaMemcpy(dx.data,input.data(),input.size()*2,cudaMemcpyHostToDevice));\n    check(cudaMemcpy(before.data,residual.data(),residual.size()*2,cudaMemcpyHostToDevice));\n    check(cudaMemcpy(after.data,residual.data(),residual.size()*2,cudaMemcpyHostToDevice));\n    auto* scale_bytes=reinterpret_cast<const std::uint8_t*>(ds.data);\n    shipped::q5_small_t_mma_launch<K,Tokens>(dx.data,dc.data,dh.data,scale_bytes,Rows,\n        shipped::Q5SmallTMmaAddResidual{before.data,Rows},nullptr);\n    using Schedule=current::Q5A16SlicedKMmaSchedule<16,Tokens,8,Tokens==8?3:2,\n        ninfer::ops::Cache::cg,ninfer::ops::Cache::ca,1,K,Tokens,\n        current::Q5SlicedKReduction::Linear,16,false>;\n    current::q5_a16_sliced_k_mma_kernel<Schedule,true,true><<<Rows/16,256>>>(\n        dx.data,dc.data,dh.data,scale_bytes,Store{after.data,Rows},Identity{},Rows,\n        K,Tokens,K,0,current::Q5IdentityRows<16>{});\n    check(cudaGetLastError());check(cudaDeviceSynchronize());\n    std::vector<std::uint16_t> expected(residual.size()),actual(residual.size());\n    check(cudaMemcpy(expected.data(),before.data,expected.size()*2,cudaMemcpyDeviceToHost));\n    check(cudaMemcpy(actual.data(),after.data,actual.size()*2,cudaMemcpyDeviceToHost));\n    std::size_t mismatches=0;\n    for(std::size_t i=0;i<actual.size();++i)mismatches+=actual[i]!=expected[i];\n    total_values+=actual.size();total_mismatches+=mismatches;\n    std::printf(\"%s{\\\"k\\\":%d,\\\"