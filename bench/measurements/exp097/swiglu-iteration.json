  "proof_source_utf8": "// EXP-097: full fused outputs against unmodified 1302d639 Q4 kernel headers.\n#include <cuda_runtime.h>\n#include <cuda_pipeline.h>\n#include <cuda_bf16.h>\n#include <cuda_fp16.h>\n#include <cstddef>\n#include <cstdint>\n#include <type_traits>\n#include <utility>\n#include <cstdio>\n#include <cstdlib>\n#include <random>\n#include <vector>\n#include \"ops/linear/kernels/q4/q4_a16_sliced_k_mma.cuh\"\n#include \"ops/linear/kernels/q4/q4_instances.cuh\"\nnamespace shipped_reference {\n#include \"ops/linear/q4/q4_small_t_mma.cuh\"\n}\nnamespace current=ninfer::ops::detail;\nnamespace shipped=shipped_reference::ninfer::ops::detail;\nconstexpr int K=5120,N=34816,Intermediate=N/2;\nstatic void check(cudaError_t e){if(e!=cudaSuccess){std::fprintf(stderr,\"%s\\n\",cudaGetErrorString(e));std::exit(2);}}\ntemplate<class T> struct Buffer{T* data{};explicit Buffer(std::size_t n){check(cudaMalloc(&data,n*sizeof(T)));}~Buffer(){cudaFree(data);}Buffer(const Buffer&)=delete;};\nstruct Geometry{static constexpr int kInputRows=K,kGroupsPerRow=K/64;};\n// The production row maps and fused SiLU expressions are identical in both trees.\nstruct Rows{\n static constexpr int kOutputRowsPerCta=8;\n __host__ __device__ int output_rows(int rows)const{return rows/2;}\n __device__ int weight_row(int start,int local)const{return start+(local&7)+(local>=8?Intermediate:0);}\n};\n__device__ float silu(float x){return x/(1.0f+expf(-x));}\nstruct Store{__nv_bfloat16* data;__device__ void store(int row,int token,float v)const{data[std::int64_t(token)*Intermediate+row]=__float2bfloat16_rn(v);}};\nstruct ForkEpilogue{\n __nv_bfloat16* out;\n template<int Active> __device__ void store(int row,int token,float4 v)const{\n  if(token<Active)out[std::int64_t(token)*Intermediate+row]=__float2bfloat16_rn(silu(v.x)*v.z);\n  if(token+1<Active)out[std::int64_t(token+1)*Intermediate+row]=__float2bfloat16_rn(silu(v.y)*v.w);\n }\n};\nstruct CurrentEpilogue{\n template<class Output> __device__ void store_fragment(const Output& out,int row,int token,float4 v,int rows,int end)const{\n  if(row>=rows/2)return;\n  if(token<end)out.store(row,token,silu(v.x)*v.z);\n  if(token+1<end)out.store(row,token+1,silu(v.y)*v.w);\n }\n};\nstd::size_t total_values=0,total_mismatches=0;bool first=true;\ntemplate<int Tokens> void compare(unsigned seed){\n std::mt19937 random(seed);std::uniform_real_distribution<float> value(-1.f,1.f),scale(.001f,.125f);\n std::vector<std::uint8_t> codes(std::size_t(N)*K/2);std::vector<__half> scales(std::size_t(N)*K/64);std::vector<__nv_bfloat16> input(K*Tokens);\n for(auto& x:codes)x=static_cast<std::uint8_t>(random());for(auto& x:scales)x=__float2half(scale(random));for(auto& x:input)x=__float2bfloat16_rn(value(random));\n Buffer<std::uint8_t> dc(codes.size());Buffer<__half> ds(scales.size());Buffer<__nv_bfloat16> dx(input.size()),before(Intermediate*Tokens),after(Intermediate*Tokens);\n check(cudaMemcpy(dc.data,codes.data(),codes.size(),cudaMemcpyHostToDevice));check(cudaMemcpy(ds.data,scales.data(),scales.size()*2,cudaMemcpyHostToDevice));check(cudaMemcpy(dx.data,input.data(),input.size()*2,cudaMemcpyHostToDevice));\n auto* scale_bytes=reinterpret_cast<const std::uint8_t*>(ds.data);\n shipped::q4_small_t_mma_kernel<Geometry,Tokens,Tokens,ForkEpilogue,Rows><<<Intermediate/8,256>>>(dx.data,dc.data,scale_bytes,before.data,ForkEpilogue{before.data},Rows{});\n using Schedule=std::conditional_t<Tokens==8,current::q4_instances::SlicedK5120T8PairwisePad16,current::q4_instances::SlicedK5120T16PairwisePad16>;\n current::q4_a16_sliced_k_mma_kernel<Schedule,true,true><<<Intermediate/8,256>>>(dx.data,dc.data,scale_bytes,Store{after.data},CurrentEpilogue{},N,K,Tokens,K,0,Rows{});\n check(cudaGetLastError());check(cudaDeviceSynchronize());\n std::vector<std::uint16_t> expected(Intermediate*Tokens),actual(Intermediate*Tokens);check(cudaMemcpy(expected.data(),before.data,expected.size()*2,cudaMemcpyDeviceToHost));check(cudaMemcpy(actual.data(),after.data,actual.size()*2,cudaMemcpyDeviceToHost));\n std::size_t differences=0;for(std::size_t i=0;i<actual.size();++i)differences+=actual[i]!=expected[i];total_values+=actual.size();total_mismatches+=differences;\n std::printf(\"%s{\\\"tokens\\\":%d,\\\"seed\\\":%u,\\\"values\\\":%zu,\\\"bit_mismatches\\\":%zu}\",first?\"\":\",\",Tokens,seed,actual.size(),differences);first=false;\n}\nint main(){std::printf(\"{\\\"reference\\\":\\\"1302d639\\\",\\\"cases\\\":[\");for(unsigned seed:{1U,17U,103U,501U}){compare<8>(seed);compare<16>(seed);}std::printf(\"],\\\"total_values\\\":%zu,\\\"total_bit_mismatches\\\":%zu}\\n\",total_values,total_mismatches);return total_mismatches?1:0;}\n",
