  "proof_source_utf8": "// EXP-097: every FP32 shortlist projection score against unmodified 1302d639 headers.\n#include <cuda_runtime.h>\n#include <cuda_pipeline.h>\n#include <cuda_bf16.h>\n#include <cuda_fp16.h>\n#include <cstddef>\n#include <cstdint>\n#include <type_traits>\n#include <utility>\n#include <cstdio>\n#include <cstdlib>\n#include <random>\n#include <vector>\n#include \"ops/linear/kernels/q4/q4_a16_sliced_k_mma.cuh\"\n#include \"ops/linear/kernels/q4/q4_instances.cuh\"\nnamespace shipped_reference {\n#include \"ops/linear/q4/q4_small_t_mma.cuh\"\n}\nnamespace current=ninfer::ops::detail;\nnamespace shipped=shipped_reference::ninfer::ops::detail;\nconstexpr int K=5120,Rows=131072;\nstatic void check(cudaError_t e){if(e!=cudaSuccess){std::fprintf(stderr,\"%s\\n\",cudaGetErrorString(e));std::exit(2);}}\ntemplate<class T> struct Buffer{T* data{};explicit Buffer(std::size_t n){check(cudaMalloc(&data,n*sizeof(T)));}~Buffer(){cudaFree(data);}Buffer(const Buffer&)=delete;};\nstruct Geometry{static constexpr int kInputRows=K,kOutputRows=Rows,kGroupsPerRow=K/64;};\nstruct Store{float* data;__device__ void store(int row,int token,float v)const{data[std::int64_t(token)*Rows+row]=v;}};\nstruct Identity{__device__ float apply(int,int,float v)const{return v;}};\nstruct ForkEpilogue{\n float* out;int columns;\n template<int Capacity> __device__ void store(int row,int token,float4 v)const{\n  if(token<columns){out[std::int64_t(token)*Rows+row]=v.x;out[std::int64_t(token)*Rows+row+8]=v.z;}\n  if(token+1<columns){out[std::int64_t(token+1)*Rows+row]=v.y;out[std::int64_t(token+1)*Rows+row+8]=v.w;}\n }\n};\nstd::size_t total_values=0,total_mismatches=0;bool first=true;\ntemplate<int Tokens> void compare(unsigned seed){\n constexpr int Capacity=Tokens<=8?8:16;\n std::mt19937 random(seed);std::uniform_real_distribution<float> value(-1.f,1.f),scale(.001f,.125f);\n std::vector<std::uint8_t> codes(std::size_t(Rows)*K/2);std::vector<__half> scales(std::size_t(Rows)*K/64);std::vector<__nv_bfloat16> input(K*Tokens);\n for(auto& x:codes)x=static_cast<std::uint8_t>(random());for(auto& x:scales)x=__float2half(scale(random));for(auto& x:input)x=__float2bfloat16_rn(value(random));\n Buffer<std::uint8_t> dc(codes.size());Buffer<__half> ds(scales.size());Buffer<__nv_bfloat16> dx(input.size());Buffer<float> before(Rows*Tokens),after(Rows*Tokens);\n check(cudaMemcpy(dc.data,codes.data(),codes.size(),cudaMemcpyHostToDevice));check(cudaMemcpy(ds.data,scales.data(),scales.size()*2,cudaMemcpyHostToDevice));check(cudaMemcpy(dx.data,input.data(),input.size()*2,cudaMemcpyHostToDevice));\n auto* scale_bytes=reinterpret_cast<const std::uint8_t*>(ds.data);\n shipped::q4_small_t_mma_kernel<Geometry,Capacity,Capacity,ForkEpilogue,shipped::Q4SmallTMmaIdentityRows,true><<<Rows/16,256>>>(dx.data,dc.data,scale_bytes,nullptr,ForkEpilogue{before.data,Tokens},shipped::Q4SmallTMmaIdentityRows{},Tokens);\n using Schedule=std::conditional_t<Capacity==8,current::q4_instances::SlicedK5120T8PairwisePad16,current::q4_instances::SlicedK5120T16PairwisePad16>;\n current::q4_a16_sliced_k_mma_kernel<Schedule,true,false><<<Rows/16,256>>>(dx.data,dc.data,scale_bytes,Store{after.data},Identity{},Rows,K,Tokens,K,0,current::Q4IdentityRows<16>{});\n check(cudaGetLastError());check(cudaDeviceSynchronize());\n std::vector<std::uint32_t> expected(Rows*Tokens),actual(Rows*Tokens);check(cudaMemcpy(expected.data(),before.data,expected.size()*4,cudaMemcpyDeviceToHost));check(cudaMemcpy(actual.data(),after.data,actual.size()*4,cudaMemcpyDeviceToHost));\n std::size_t differences=0;for(std::size_t i=0;i<actual.size();++i)differences+=actual[i]!=expected[i];total_values+=actual.size();total_mismatches+=differences;\n std::printf(\"%s{\\\"tokens\\\":%d,\\\"seed\\\":%u,\\\"values\\\":%zu,\\\"bit_mismatches\\\":%zu}\",first?\"\":\",\",Tokens,seed,actual.size(),differences);first=false;\n}\nint main(){std::printf(\"{\\\"reference\\\":\\\"1302d639\\\",\\\"precision\\\":\\\"FP32\\\",\\\"cases\\\":[\");for(unsigned seed:{1U,17U,103U,501U}){compare<7>(seed);compare<14>(seed);}std::printf(\"],\\\"total_values\\\":%zu,\\\"total_bit_mismatches\\\":%zu}\\n\",total_values,total_mismatches);return total_mismatches?1:0;}\n",
